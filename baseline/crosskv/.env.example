# Hugging Face model IDs and local checkpoint directories are both supported.
XKV_SOURCE_MODEL=Qwen/Qwen3-8B
XKV_TARGET_MODEL=Qwen/Qwen3-32B

# Required: Parquet, JSON, JSONL, glob, or directory containing calibration text.
XKV_CALIBRATION_DATA=/path/to/calibration-data.parquet
XKV_TEXT_FIELD=text

# Generated activation stores and fitted mapper. This directory is git-ignored.
XKV_WORK_DIR=work/qwen3_8b_to_32b

# Paper defaults for Qwen3-8B -> Qwen3-32B.
XKV_NUM_SEQUENCES=500
XKV_SEQUENCE_LENGTH=1024
XKV_STRIDE=4
XKV_TOP_K=12
XKV_RIDGE=0.01
XKV_WEIGHT_DTYPE=float32

# Runtime configuration. CUDA_VISIBLE_DEVICES may also be set before launching.
XKV_DEVICE=cuda:0
XKV_DEVICE_MAP=auto
XKV_ATTN_IMPLEMENTATION=sdpa
